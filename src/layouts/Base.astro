---
// Poppins hébergée avec le site (plus rapide que Google Fonts, aucun appel externe)
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { siteConfig, seo, ui, facebookUrl, imageExists, isIndexable } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = seo.defaultDescription } = Astro.props;
const pageTitle = title ? `${title}${seo.titleSuffix}` : seo.defaultTitle;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Image de partage : og-image.jpg si fournie, sinon le logo
const ogImagePath = imageExists(siteConfig.ogImage) ? siteConfig.ogImage : siteConfig.logo;
const ogImage = Astro.site ? new URL(ogImagePath, Astro.site).href : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: siteConfig.fullName,
  alternateName: siteConfig.name,
  foundingDate: String(siteConfig.foundedYear),
  email: siteConfig.contact.email,
  telephone: siteConfig.contact.phoneHref,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Saint-Paul',
    postalCode: '97423',
    addressRegion: 'La Réunion',
    addressCountry: 'FR',
  },
  sameAs: [facebookUrl],
  ...(Astro.site ? { url: Astro.site.href } : {}),
};
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={isIndexable ? 'index, follow' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={siteConfig.themeColor} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:site_name" content={siteConfig.fullName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={siteConfig.fullName} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="sitemap" href="/sitemap.xml" />

    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{ui.skipLink}</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script>
      const items = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
