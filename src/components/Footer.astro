---
import Icon from './Icon.astro';
import { siteConfig, footer, navigation, telHref, mailHref } from '../lib/site';
import partenaires from '../data/partenaires.json';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__about">
        <a class="footer__brand" href="/">
          <img src={siteConfig.logoSmall} alt="" width="128" height="128" loading="lazy" decoding="async" />
          <span>{siteConfig.fullName}</span>
        </a>
        <p>{footer.about}</p>
        <a class="btn btn--primary" href={telHref}>
          {footer.cta}
          <span class="btn__puck"><Icon name="phone" size={18} /></span>
        </a>
        <ul class="footer__social">
          {
            siteConfig.social.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener" aria-label={s.name}>
                  <Icon name={s.icon} size={22} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        navigation.footer.map((col) => (
          <nav class="footer__col" aria-label={col.title}>
            <h2 class="footer__heading">{col.title}</h2>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="footer__col">
        <h2 class="footer__heading">{footer.contactTitle}</h2>
        <ul>
          <li><a href={telHref}>{siteConfig.contact.phoneDisplay}</a></li>
          <li><a href={mailHref} class="footer__mail">{siteConfig.contact.email}</a></li>
          <li class="footer__address">{siteConfig.contact.addressShort}</li>
        </ul>
      </div>
    </div>

    {
      partenaires.partenaires.length > 0 && (
        <div class="footer__partners">
          <p class="footer__partners-title">{partenaires.footerTitre}</p>
          <ul>
            {partenaires.partenaires.map((p) => (
              <li>
                <span class="footer__partner">
                  <img src={p.logo} alt="" width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" />
                  {p.nom}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="footer__bottom">
      <p>© {year} {siteConfig.name} – {siteConfig.fullName}</p>
      <ul>
        {navigation.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li>{footer.madeWith}</li>
      </ul>
    </div>
  </div>

  <p class="footer__giant" aria-hidden="true">{siteConfig.name}</p>
</footer>

<style>
  .footer {
    overflow: hidden;
    padding-top: clamp(4rem, 3rem + 4vw, 6rem);
    background: var(--bleu-nuit);
    color: var(--texte-sur-fonce);
  }

  .footer a:not(.btn) {
    color: var(--blanc);
    text-decoration: none;
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 3rem;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .footer__brand img {
    width: 64px;
    height: 64px;
    padding: 4px;
    border-radius: 1rem;
    background: var(--blanc);
  }

  .footer__about > p {
    max-width: 26rem;
    margin-bottom: 1.75rem;
  }

  .footer__social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 0.1);
    transition: background-color var(--transition);
  }

  .footer__social a:hover {
    background: var(--facebook);
  }

  .footer__heading {
    margin-bottom: 1.25rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--jaune);
  }

  .footer__col ul {
    display: grid;
    gap: 0.4rem;
    padding-left: 1.25rem;
    border-left: 1px solid rgb(255 255 255 / 0.2);
  }

  .footer__col a {
    display: inline-block;
    padding-block: 0.3rem;
    font-weight: 600;
  }

  .footer__col a:hover,
  .footer__bottom a:hover {
    color: var(--jaune);
    text-decoration: underline;
  }

  .footer__mail {
    font-size: var(--fs-sm);
    overflow-wrap: anywhere;
  }

  .footer__address {
    padding-block: 0.3rem;
  }

  /* Partenaires : petite mention discrète sur toutes les pages */
  .footer__partners {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    font-size: var(--fs-sm);
  }

  .footer__partners-title {
    margin: 0;
  }

  .footer__partners ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer__partner {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0.9rem 0.3rem 0.35rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    color: var(--blanc);
    font-weight: 600;
  }

  /* Pastille blanche : le logo (noir) reste lisible sur le fond bleu nuit */
  .footer__partner img {
    width: 3.25rem;
    height: 2rem;
    padding: 0.2rem 0.3rem;
    object-fit: contain;
    border-radius: 999px;
    background: var(--blanc);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(255 255 255 / 0.15);
    font-size: var(--fs-sm);
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  .footer__bottom a {
    color: var(--texte-sur-fonce);
  }

  /* Grand « AJAC » décoratif en pied de page */
  .footer__giant {
    margin: 2rem 0 0;
    font-size: clamp(6rem, 30vw, 26rem);
    font-weight: 800;
    line-height: 0.75;
    letter-spacing: -0.03em;
    text-align: center;
    color: var(--jaune);
    user-select: none;
    transform: translateY(0.08em);
  }

  @media (max-width: 1023px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
    .footer__about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
  }
</style>
