---
// Smartphone dessiné en CSS (cadre, Dynamic Island, boutons latéraux, reflet)
// qui affiche une capture d'écran et flotte doucement.
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

const { src, alt, width = 601, height = 1240 } = Astro.props;
---

<div class="phone">
  <div class="phone__frame">
    <span class="phone__btn phone__btn--action" aria-hidden="true"></span>
    <span class="phone__btn phone__btn--vol-up" aria-hidden="true"></span>
    <span class="phone__btn phone__btn--vol-down" aria-hidden="true"></span>
    <span class="phone__btn phone__btn--power" aria-hidden="true"></span>
    <div class="phone__screen">
      <img src={src} alt={alt} width={width} height={height} decoding="async" fetchpriority="high" />
      <span class="phone__island" aria-hidden="true"></span>
      <span class="phone__glare" aria-hidden="true"></span>
    </div>
  </div>
  <span class="phone__shadow" aria-hidden="true"></span>
</div>

<style>
  .phone {
    --w: min(300px, 72vw);
    position: relative;
    width: var(--w);
    margin-inline: auto;
  }

  .phone__frame {
    position: relative;
    padding: calc(var(--w) * 0.035);
    border-radius: calc(var(--w) * 0.16);
    /* Cadre « titane » : dégradé + liseré clair */
    background: linear-gradient(145deg, #3a4250 0%, #12161d 45%, #2b313b 100%);
    box-shadow:
      inset 0 0 0 2px rgb(255 255 255 / 0.12),
      inset 0 0 0 5px #0b0e13,
      0 50px 90px -30px rgb(23 50 79 / 0.55),
      0 25px 40px -25px rgb(0 0 0 / 0.5);
    animation: phone-flotte 6s ease-in-out infinite;
  }

  .phone__screen {
    position: relative;
    overflow: hidden;
    aspect-ratio: 9 / 19.5;
    border-radius: calc(var(--w) * 0.125);
    background: #000;
  }

  .phone__screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .phone__island {
    position: absolute;
    top: 2.2%;
    left: 50%;
    width: 33%;
    height: 4.2%;
    border-radius: 999px;
    background: #000;
    transform: translateX(-50%);
  }

  /* Reflet de vitre */
  .phone__glare {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, rgb(255 255 255 / 0.18) 0%, rgb(255 255 255 / 0) 35%);
    pointer-events: none;
  }

  .phone__btn {
    position: absolute;
    width: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, #1b2028, #4a525f);
  }

  .phone__btn--action {
    top: 17%;
    left: -3px;
    height: 5%;
  }
  .phone__btn--vol-up {
    top: 25%;
    left: -3px;
    height: 9%;
  }
  .phone__btn--vol-down {
    top: 36%;
    left: -3px;
    height: 9%;
  }
  .phone__btn--power {
    top: 28%;
    right: -3px;
    height: 13%;
  }

  /* Ombre au sol qui respire avec le flottement */
  .phone__shadow {
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: -40px;
    height: 24px;
    border-radius: 50%;
    background: radial-gradient(rgb(23 50 79 / 0.35), transparent 70%);
    animation: ombre-respire 6s ease-in-out infinite;
  }

  @keyframes phone-flotte {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-16px) rotate(1deg);
    }
  }

  @keyframes ombre-respire {
    0%,
    100% {
      transform: scaleX(1);
      opacity: 1;
    }
    50% {
      transform: scaleX(0.82);
      opacity: 0.6;
    }
  }
</style>
